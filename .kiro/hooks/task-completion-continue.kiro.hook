{
  "enabled": true,
  "name": "Task Completion Continuation",
  "description": "Automatically triggers when the Task Implementation Completion hook finishes to select and continue with the next unfinished task from the list",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      ".kiro/hooks/task-implementation-completion/status",
      ".kiro/specs/mlx-distributed-inference/tasks.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "The Task Implementation Completion hook has finished. Please select the next remaining unfinished task from the task list and continue implementing the stats functionality until completion. Review the current progress and identify what still needs to be done continuing our work."
  }
}