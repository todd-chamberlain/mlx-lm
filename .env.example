# MLX Distributed Inference Environment Configuration
# Copy this file to .env and customize for your environment

# API Configuration
API_KEYS=your-api-key-1,your-api-key-2,your-api-key-3
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Security
GRAFANA_PASSWORD=secure-grafana-password
REDIS_PASSWORD=secure-redis-password
METRICS_AUTH_TOKEN=secure-metrics-token

# External Services (Production)
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=secure-elasticsearch-password

# SSL Certificates (Production)
SSL_CERT_PATH=/etc/nginx/ssl/nginx.crt
SSL_KEY_PATH=/etc/nginx/ssl/nginx.key

# Monitoring
PROMETHEUS_RETENTION=30d
JAEGER_STORAGE_TYPE=elasticsearch

# Performance Tuning
MAX_WORKERS=500
WORKER_TIMEOUT=60
HEALTH_CHECK_INTERVAL=15
RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# Development Settings
ENABLE_DEBUG=false
LOG_LEVEL=INFO

# Automatic Model Sharding Configuration
# Enable automatic sharding of models across multiple workers
ENABLE_AUTO_SHARDING=false

# Minimum model size (in GB) to trigger automatic sharding
SHARD_THRESHOLD_GB=30.0

# Sharding strategy: balanced (equal layers) or memory_aware (based on memory)
SHARD_STRATEGY=balanced

# Activation compression settings
SHARD_COMPRESSION_ENABLED=true
SHARD_COMPRESSION_ALGORITHM=zstd  # Options: zstd, lz4, none
SHARD_COMPRESSION_LEVEL=3  # Compression level (1-22 for zstd)

# Activation transfer timeout in milliseconds
ACTIVATION_TIMEOUT_MS=5000

# Maximum pipeline depth (number of workers in sequence)
MAX_PIPELINE_DEPTH=4

# Minimum workers required to enable sharding
MIN_WORKERS_FOR_SHARDING=2