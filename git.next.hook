```bash
# Run all distributed layer tests
pytest tests/test_*distributed*.py -v

# Run token generation tests
pytest tests/test_distributed_generation.py -v

# Run with coverage
pytest --cov=worker --cov=coordinator tests/test_*distributed*.py

# Run specific test
pytest tests/test_distributed_generation.py::TestDistributedGenerator::test_basic_generation -v

# Check code quality
flake8 worker/distributed_generation.py
mypy worker/distributed_generation.py
